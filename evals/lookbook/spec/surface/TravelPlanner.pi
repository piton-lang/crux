export anchor TravelPlanner:
    description:
        Brightwork Trips, a made-up travel planner, on the trip Japan in April.

    trip:
        1 to 14 April 2027, Mara Okafor and one guest, budget 5,000 euros with
        3,200 saved.

    itinerary:
        - 1 Apr, flight BW 284 Berlin to Tokyo, departs 13:05, arrives 08:40 next day
        - 2 to 6 Apr, Tokyo, Hotel Kinari, 4 nights, booked
        - 6 Apr, train to Kyoto, 2 h 15 min, not booked
        - 6 to 10 Apr, Kyoto, guest house Sora, 4 nights, booked
        - 10 to 13 Apr, Osaka, not booked
        - 14 Apr, flight home

    checklist:
        - Passport valid, done
        - Rail pass, to do
        - Travel insurance, done
        - Pocket wifi, to do

    weather:
        Tokyo in early April, highs around 17 degrees, cherry blossom likely.

    map:
        A route map linking Tokyo, Kyoto and Osaka.
