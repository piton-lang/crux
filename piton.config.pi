use @piton/belay
use @piton/config
use @piton/packaging

from @piton/belay import ClaudeCodeAdapter, CodexAdapter, OpenCodeAdapter

export piton-config CruxProject:
    root: ./spec
    entry: ./spec/index.pi

    frameworks:
        - {BelayConfiguration}

    packages:
        - {Crux}

belay-config BelayConfiguration:
    codeRoot: .
    crossDiscovery: separate

    adapters:
        - {ClaudeCodeAdapter}
        - {CodexAdapter}
        - {OpenCodeAdapter}

piton-package Crux:
    name: crux
    root: ./spec
